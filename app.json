{
  "expo": {
    "name": "aestilibrum",
    "slug": "aestilibrum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/model/*",
      "assets/images/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aestilibrum",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja potrzebuje dostępu do kamery do skanowania książek",
        "NSPhotoLibraryUsageDescription": "Aplikacja potrzebuje dostępu do galerii do analizy zdjęć książek",
        "NSMicrophoneUsageDescription": "Aplikacja może potrzebować dostępu do mikrofonu dla niektórych funkcji",
        "NSPhotoLibraryAddUsageDescription": "Aplikacja potrzebuje dostępu do galerii do zapisywania zdjęć"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeCamera",
            "NSPrivacyAccessedAPITypeReasons": [
              "DDA9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypePhotoLibrary",
            "NSPrivacyAccessedAPITypeReasons": [
              "PHL3.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeSystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPITypeActiveKeyboards",
            "NSPrivacyAccessedAPITypeReasons": [
              "3B52.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      }
    },
    "android": {
      "package": "com.jagodzip.aestilibrum",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacja potrzebuje dostępu do zdjęć do analizy stanu książek.",
          "cameraPermission": "Aplikacja potrzebuje dostępu do kamery do robienia zdjęć książek."
        }
      ],
      [
        "expo-barcode-scanner",
        {
          "cameraPermission": "Aplikacja potrzebuje dostępu do kamery do skanowania kodów kreskowych."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja potrzebuje dostępu do kamery do analizy stanu książek."
        }
      ],
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.23",
            "enableProguardInReleaseBuilds": true,
            "extraMavenRepos": [
              "$rootDir/../node_modules/@tensorflow/tfjs-react-native/dist/tfjs-react-native.aar"
            ]
          },
          "ios": {
            "deploymentTarget": "15.0",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./app",
        "asyncRoutes": {
          "(tabs)/index": "./app/(tabs)/index",
          "(tabs)/two": "./app/(tabs)/two",
          "(tabs)/three": "./app/(tabs)/three",
          "(tabs)/four": "./app/(tabs)/four"
        }
      },
      "eas": {
        "projectId": "475267f1-a846-4802-a6e9-a58d2db082af"
      }
    },
    "owner": "jagodzip",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/475267f1-a846-4802-a6e9-a58d2db082af"
    }
  }
}